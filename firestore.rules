rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the owner can read/write. The bot uses the Admin SDK and bypasses these rules.
    // (Published manually in Firebase console → Firestore → Rules.)
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'nickolaykolchev@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
